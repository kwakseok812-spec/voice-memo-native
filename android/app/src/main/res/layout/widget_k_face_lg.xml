<?xml version="1.0" encoding="utf-8"?>
<!-- v8.2(O-0157) 케이 위젯 — 정사각 2×2: 큰 얼굴 + 제목 + 한두 줄 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wk_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:padding="10dp">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center">
        <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
            <ImageView android:id="@+id/wk_face"
                android:layout_width="72dp" android:layout_height="72dp"
                android:layout_margin="4dp"
                android:src="@drawable/k_face_round" android:scaleType="fitCenter"
                android:contentDescription="케이" />
            <TextView android:id="@+id/wk_badge"
                android:layout_width="wrap_content" android:layout_height="24dp"
                android:minWidth="24dp" android:layout_gravity="top|end"
                android:background="@drawable/widget_badge" android:gravity="center"
                android:paddingLeft="6dp" android:paddingRight="6dp"
                android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>
        <TextView android:id="@+id/wk_title"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1" android:ellipsize="end"
            android:textColor="#F3F6FF" android:textSize="13.5sp" android:textStyle="bold" />
        <TextView android:id="@+id/wk_line"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:maxLines="2" android:ellipsize="end" android:gravity="center"
            android:textColor="#B8C2E0" android:textSize="11.5sp" />
    </LinearLayout>
</FrameLayout>
